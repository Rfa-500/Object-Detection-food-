"""
Food & Snack Detection Bot
Main detection module with YOLO-based object detection
"""

import cv2
import numpy as np
from datetime import datetime
import json
from typing import List, Dict, Tuple, Optional
import uuid

from nutrition_database import NutritionDatabase
from portion_estimator import PortionEstimator


class FoodDetectionBot:
    """
    Main food detection bot that processes images and returns nutritional analysis
    """
    
    def __init__(self, model_path: Optional[str] = None, confidence_threshold: float = 0.60):
        """
        Initialize the food detection bot
        
        Args:
            model_path: Path to YOLO model weights (if None, uses mock detection)
            confidence_threshold: Minimum confidence for detections (0.0-1.0)
        """
        self.confidence_threshold = confidence_threshold
        self.nutrition_db = NutritionDatabase()
        self.portion_estimator = PortionEstimator()
        
        # Food classes the bot can detect
        self.food_classes = [
            # Fruits
            "apple", "banana", "orange", "grapes", "strawberries", "watermelon", "avocado",
            # Vegetables
            "carrot", "broccoli", "tomato", "cucumber", "bell_pepper", "lettuce",
            # Proteins
            "chicken_breast", "steak", "salmon", "eggs", "tofu", "ground_beef",
            # Grains
            "rice", "pasta", "bread_slice", "bagel", "tortilla", "oatmeal",
            # Snacks
            "chips", "cookies", "chocolate_bar", "granola_bar", "pretzels", "popcorn",
            # Dairy
            "yogurt", "cheese", "milk", "protein_shake",
            # Fast Food
            "burger", "pizza_slice", "hot_dog", "sandwich", "taco", "burrito",
            # Beverages
            "soda_can", "juice_box", "water_bottle", "energy_drink", "coffee_cup",
            # Processed
            "instant_noodles", "cereal", "protein_bar", "nuts", "dried_fruit",
            # Sides
            "french_fries", "salad", "soup"
        ]
        
        # Reference objects for portion estimation
        self.reference_classes = [
            "hand", "credit_card", "soda_can", "smartphone", "dinner_plate", "coin"
        ]
        
        self.all_classes = self.food_classes + self.reference_classes
        
        # Initialize model (mock for this implementation)
        self.model_loaded = False
        if model_path:
            try:
                # In production: load actual YOLO model
                # self.model = YOLO(model_path)
                self.model_loaded = True
                print(f"Model loaded from {model_path}")
            except Exception as e:
                print(f"Warning: Could not load model: {e}")
                print("Using mock detection mode")
        else:
            print("No model path provided. Using mock detection mode.")
    
    def detect_objects(self, image: np.ndarray) -> List[Dict]:
        """
        Detect food and reference objects in the image
        
        Args:
            image: Input image as numpy array (BGR format)
            
        Returns:
            List of detections with class, confidence, and bounding box
        """
        if self.model_loaded:
            # In production: Use actual YOLO model
            # results = self.model(image)
            # detections = self._parse_yolo_results(results)
            pass
        
        # Mock detection for demonstration
        detections = self._mock_detection(image)
        
        # Filter by confidence threshold
        detections = [d for d in detections if d['confidence'] >= self.confidence_threshold]
        
        return detections
    
    def _mock_detection(self, image: np.ndarray) -> List[Dict]:
        """
        Mock detection for demonstration purposes
        Simulates detecting objects in the image
        """
        height, width = image.shape[:2]
        
        # Simulate some detections
        detections = [
            {
                'class': 'apple',
                'confidence': 0.91,
                'bbox': {
                    'x_min': int(width * 0.15),
                    'y_min': int(height * 0.25),
                    'x_max': int(width * 0.35),
                    'y_max': int(height * 0.55),
                }
            },
            {
                'class': 'banana',
                'confidence': 0.87,
                'bbox': {
                    'x_min': int(width * 0.45),
                    'y_min': int(height * 0.30),
                    'x_max': int(width * 0.65),
                    'y_max': int(height * 0.50),
                }
            },
            {
                'class': 'soda_can',
                'confidence': 0.94,
                'bbox': {
                    'x_min': int(width * 0.70),
                    'y_min': int(height * 0.20),
                    'x_max': int(width * 0.82),
                    'y_max': int(height * 0.60),
                }
            }
        ]
        
        # Add bbox dimensions
        for det in detections:
            bbox = det['bbox']
            bbox['width'] = bbox['x_max'] - bbox['x_min']
            bbox['height'] = bbox['y_max'] - bbox['y_min']
        
        return detections
    
    def process_image(self, image_path: str) -> Dict:
        """
        Process a single image and return complete nutritional analysis
        
        Args:
            image_path: Path to the image file
            
        Returns:
            Dictionary with complete detection and nutrition results
        """
        # Read image
        image = cv2.imread(image_path)
        if image is None:
            raise ValueError(f"Could not read image: {image_path}")
        
        return self.process_frame(image)
    
    def process_frame(self, image: np.ndarray) -> Dict:
        """
        Process a single frame and return complete nutritional analysis
        
        Args:
            image: Image as numpy array (BGR format)
            
        Returns:
            Dictionary with complete detection and nutrition results
        """
        start_time = datetime.now()
        
        # Detect objects
        detections = self.detect_objects(image)
        
        # Separate food items and reference objects
        food_items = [d for d in detections if d['class'] in self.food_classes]
        reference_objects = [d for d in detections if d['class'] in self.reference_classes]
        
        # Find best reference object (highest confidence)
        reference_object = None
        if reference_objects:
            reference_object = max(reference_objects, key=lambda x: x['confidence'])
        
        # Calculate pixel-to-cm ratio if reference available
        pixels_per_cm = None
        if reference_object:
            pixels_per_cm = self.portion_estimator.calculate_scale(
                reference_object['class'],
                reference_object['bbox']
            )
        
        # Process each food item
        processed_items = []
        warnings = []
        
        for idx, food_det in enumerate(food_items):
            item_id = f"item_{str(idx + 1).zfill(3)}"
            
            # Estimate portion
            portion_info = self.portion_estimator.estimate_portion(
                food_class=food_det['class'],
                bbox=food_det['bbox'],
                reference_object=reference_object['class'] if reference_object else None,
                pixels_per_cm=pixels_per_cm
            )
            
            # Get nutrition data
            nutrition = self.nutrition_db.get_nutrition(
                food_class=food_det['class'],
                weight_grams=portion_info['weight_grams']
            )
            
            # Determine flags
            flags = []
            if food_det['confidence'] < 0.75:
                flags.append("low_confidence")
                warnings.append(
                    f"Item '{food_det['class']}' has low detection confidence "
                    f"({food_det['confidence']:.2f}). Nutritional values may be less accurate."
                )
            
            if portion_info['weight_confidence'] < 0.70:
                flags.append("uncertain_portion")
            
            # Build item result
            item_result = {
                'item_id': item_id,
                'class': food_det['class'],
                'confidence': round(food_det['confidence'], 2),
                'bounding_box': food_det['bbox'],
                'portion': portion_info,
                'nutrition': nutrition,
                'flags': flags
            }
            
            processed_items.append(item_result)
        
        # Calculate totals
        totals = self._calculate_totals(processed_items)
        
        # Calculate processing time
        processing_time = (datetime.now() - start_time).total_seconds() * 1000
        
        # Build final result
        result = {
            'detection_id': f"det_{datetime.now().strftime('%Y%m%d_%H%M%S')}_{uuid.uuid4().hex[:4]}",
            'timestamp': datetime.now().isoformat() + 'Z',
            'detection_summary': {
                'total_items_detected': len(food_items),
                'reference_object_found': reference_object is not None,
                'reference_object_type': reference_object['class'] if reference_object else None,
                'overall_confidence': round(
                    sum(item['confidence'] for item in processed_items) / len(processed_items), 2
                ) if processed_items else 0.0
            },
            'detected_items': processed_items,
            'totals': totals,
            'warnings': warnings,
            'metadata': {
                'model_version': 'food_detector_v2.3',
                'processing_time_ms': int(processing_time),
                'image_resolution': f"{image.shape[1]}x{image.shape[0]}"
            }
        }
        
        return result
    
    def _calculate_totals(self, items: List[Dict]) -> Dict:
        """Calculate total nutrition across all items"""
        if not items:
            return {
                'total_calories': 0,
                'total_carbohydrates_g': 0,
                'total_protein_g': 0,
                'total_fat_g': 0,
                'total_fiber_g': 0
            }
        
        totals = {
            'total_calories': sum(item['nutrition']['calories'] for item in items),
            'total_carbohydrates_g': round(
                sum(item['nutrition']['carbohydrates_g'] for item in items), 1
            ),
            'total_protein_g': round(
                sum(item['nutrition']['protein_g'] for item in items), 1
            ),
            'total_fat_g': round(
                sum(item['nutrition']['fat_g'] for item in items), 1
            ),
            'total_fiber_g': round(
                sum(item['nutrition']['fiber_g'] for item in items), 1
            )
        }
        
        return totals
    
    def process_camera_stream(self, camera_index: int = 0):
        """
        Process live camera stream (for testing purposes)
        
        Args:
            camera_index: Camera device index (usually 0 for default camera)
        """
        cap = cv2.VideoCapture(camera_index)
        
        if not cap.isOpened():
            raise RuntimeError("Could not open camera")
        
        print("Camera opened. Press 'c' to capture and analyze, 'q' to quit.")
        
        while True:
            ret, frame = cap.read()
            if not ret:
                print("Failed to grab frame")
                break
            
            # Display frame
            cv2.imshow('Food Detection Bot - Press C to Capture', frame)
            
            key = cv2.waitKey(1) & 0xFF
            
            if key == ord('c'):
                # Capture and process
                print("\nCapturing and analyzing...")
                result = self.process_frame(frame)
                
                # Save result to file
                timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
                output_file = f"detection_result_{timestamp}.json"
                
                with open(output_file, 'w') as f:
                    json.dump(result, f, indent=2)
                
                print(f"\nResults saved to: {output_file}")
                print(f"\nDetected {result['detection_summary']['total_items_detected']} items")
                print(f"Total calories: {result['totals']['total_calories']} kcal")
                print(f"Total carbs: {result['totals']['total_carbohydrates_g']}g")
                print(f"Total protein: {result['totals']['total_protein_g']}g")
                
                # Display items
                for item in result['detected_items']:
                    print(f"\n- {item['class']}: {item['nutrition']['calories']} kcal, "
                          f"{item['portion']['weight_grams']}g")
                
                print("\nPress 'c' to capture again, 'q' to quit.")
            
            elif key == ord('q'):
                break
        
        cap.release()
        cv2.destroyAllWindows()


if __name__ == "__main__":
    # Example usage
    bot = FoodDetectionBot(confidence_threshold=0.60)
    
    # Process a test image (create a dummy image for testing)
    test_image = np.zeros((720, 1280, 3), dtype=np.uint8)
    test_image[:] = (240, 240, 240)  # Light gray background
    
    result = bot.process_frame(test_image)
    
    # Print result
    print(json.dumps(result, indent=2))
